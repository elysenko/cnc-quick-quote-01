{
  "name": "cnc-quick-quote-backend",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed/seed.js"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "node prisma/seed/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.1",
    "reflect-metadata": "^0.2.0",
    "resend": "^4.0.1",
    "rxjs": "~7.8.0",
    "stripe": "^17.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.13.9",
    "jest": "^29.7.0",
    "prisma": "^6.16.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.0",
    "typescript": "~5.7.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "isolatedModules": true }] },
    "testEnvironment": "node"
  }
}
